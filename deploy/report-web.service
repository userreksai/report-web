[Unit]
Description=Report Web Vue Frontend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/report-web
Environment=NODE_ENV=production
Environment=PORT=8888
Environment=REPORT_API_ORIGIN=http://127.0.0.1:10010
ExecStart=/usr/bin/node /opt/report-web/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
